# ---------------------------------------------------------------------------
# AfriVibe — variables d'environnement
#
# Ce fichier est un MODÈLE. Copiez-le en `.env` (ignoré par Git) et renseignez
# vos propres valeurs. Aucune clé secrète ne doit être committée.
#
# Rappel : toute variable préfixée par EXPO_PUBLIC_ est intégrée dans le bundle
# de l'application et donc PUBLIQUE. N'y mettez jamais une clé `service_role`.
# ---------------------------------------------------------------------------

# Backend prévu (non branché pour l'instant — voir docs/BACKEND.md)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Fournisseur de données utilisé par l'application : "local" (par défaut) ou "supabase"
EXPO_PUBLIC_DATA_SOURCE=local
